@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-36 Crear usuario
autonumber

actor "Administrador" as U
participant "Interfaz web\n(Crear usuario)" as W
participant "API REST\n(UserController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el actor ha iniciado sesión como Administrador.

U -> W : Seleccionar «Crear usuario» en su menú
activate W
W --> U : Formulario de alta
U -> W : Capturar nombre de usuario, correo, teléfono, contraseña y confirmación,\ny elegir el tipo: Usuario normal, Refugio o Administrador
W -> W : Validar datos (usuario ≥ 3, correo válido, contraseña ≥ 6 con\nmayúsculas, minúsculas y números, confirmación igual)
break FA-36-A: dato faltante o inválido, o contraseñas distintas
  W --> U : Señalar el campo
end
W -> A : Crear cuenta (POST /users {..., role}, con el token del Administrador)
activate A
A -> A : Verificar en el token que es Administrador\ny conservar el rol elegido
A -> DB : Buscar usuario por correo (users)
activate DB
alt FA-36-B: el correo ya está registrado (RN-03)
  DB --> A : Usuario existente
  A --> W : 409 «Este correo ya fue registrado»
  W --> U : Mostrar el error
else correo disponible
  DB --> A : Sin coincidencias
  deactivate DB
  A -> A : Cifrar la contraseña (BCrypt)
  A -> DB : Registrar usuario (INSERT users con el rol; permiso\npara publicar si es Refugio o Administrador)
  activate DB
  DB --> A : Usuario creado
  deactivate DB
  A --> W : 200 Cuenta
  deactivate A
  W --> U : «Usuario [normal | refugio | administrador] creado exitosamente»
end
deactivate W

note over U, DB : Postcondición: la cuenta queda registrada con el rol asignado y puede iniciar sesión (CU-02).
@enduml
