@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-39 Consultar reporte general
autonumber

actor "Administrador" as U
participant "Interfaz web\n(Panel de administración)" as W
participant "API REST\n(controladores de la plataforma)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el actor ha iniciado sesión como Administrador.

U -> W : Acceder al panel de administración
activate W
alt operación exitosa
  par consultas simultáneas
    W -> A : Consultar cuentas (GET /users)
    activate A
  else
    W -> A : Consultar autorizaciones (GET /publication-authorizations)
  else
    W -> A : Consultar solicitudes de adopción (GET /adoption-requests)
  else
    W -> A : Consultar reportes (GET /reports)
  else
    W -> A : Consultar perros (GET /pets?size=9999)
  else
    W -> A : Consultar casos (GET /cases)
  end
  A -> DB : Consultar users, publication_authorization_requests,\nadoption_requests, lost_pets, pets y cases
  activate DB
  DB --> A : Registros
  deactivate DB
  A --> W : 200 Listas
  deactivate A
  W -> W : Calcular indicadores: perros registrados, en adopción y adoptados;\nreportes perdidos, encontrados y abiertos; solicitudes pendientes;\ncasos abiertos
  opt FA-39-A: no hay registros
    W --> U : Indicadores en cero
  end
  W --> U : Indicadores, gráficas de perros por estado, de reportes y de casos,\ny tablas de decisión con los registros recientes
  U -> W : Seleccionar un indicador
  W -> W : Filtrar las tablas con los registros del indicador
  W --> U : Tablas filtradas
else FA-39-B: error al consultar
  W --> U : Mostrar el mensaje de error
end
deactivate W

note over U, DB : Postcondición: el Administrador consulta el estado de la plataforma sin modificar la información.
@enduml
