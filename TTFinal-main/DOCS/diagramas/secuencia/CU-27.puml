@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-27 Consultar notificaciones
autonumber

actor "Usuario\n(cualquier rol)" as U
participant "Interfaz web\n(Encabezado)" as W
participant "API REST\n(NotificationsController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el usuario ha iniciado sesión.

loop cada 30 segundos mientras la sesión esté activa
  W -> A : Consultar resumen (GET /cases/notifications/{userId})
  activate A
  A --> W : 200 Resumen (solicitudes, avisos y casos abiertos)
  deactivate A
  W -> A : Consultar notificaciones (GET /notifications/user/{userId})
  activate A
  A -> DB : Consultar las 50 más recientes (notifications)
  activate DB
  DB --> A : Notificaciones
  deactivate DB
  A --> W : 200 Lista
  deactivate A
  W --> U : Contador de no leídas en el ícono
  opt FA-27-C: no se pudo consultar
    W -> W : Mostrar la lista vacía y reintentar en la siguiente consulta
  end
end
U -> W : Seleccionar el ícono de notificaciones
activate W
W --> U : Lista con título y mensaje (solicitudes recibidas, decisiones, avisos y respuestas,\nmensajes o cambios en casos, coincidencias con alta probabilidad)
break FA-27-A: no hay notificaciones
  W --> U : «No tienes notificaciones.»
end
alt seleccionar una notificación
  U -> W : Seleccionar una notificación
  W -> A : Marcar como leída (PATCH /notifications/{id}/read)
  activate A
  A -> DB : Actualizar (UPDATE notifications SET is_read = true)
  activate DB
  DB --> A : Notificación actualizada
  deactivate DB
  A --> W : 200
  deactivate A
  W --> U : Abrir la sección relacionada (enlace de la notificación)
else FA-27-B: «Marcar todas leídas»
  U -> W : Seleccionar «Marcar todas leídas»
  W -> A : Marcar todas (PATCH /notifications/user/{userId}/read-all)
  activate A
  A -> DB : Actualizar (UPDATE notifications)
  activate DB
  DB --> A : Notificaciones actualizadas
  deactivate DB
  A --> W : 200
  deactivate A
  W --> U : Retirar el contador
end
deactivate W

note over U, DB : Postcondición: las notificaciones consultadas quedan marcadas como leídas.
@enduml
