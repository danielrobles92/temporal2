@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-34 Revisar avisos recibidos
autonumber

actor "Autor del reporte\n(Usuario general o Refugio)" as U
participant "Interfaz web\n(Mis Anuncios – Avisos recibidos)" as W
participant "API REST\n(ReportsController / CasesController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el usuario ha iniciado sesión y tiene al menos un aviso sobre sus reportes (CU-30).

U -> W : Seleccionar la pestaña «Avisos recibidos» de «Mis Anuncios»
activate W
W -> A : Consultar avisos (GET /reports/sightings/owner/{ownerId})
activate A
A -> DB : Consultar avisos de sus reportes (report_sightings, lost_pets)
activate DB
DB --> A : Avisos
deactivate DB
A --> W : 200 Lista
deactivate A
break FA-34-D: no hay avisos
  W --> U : «Aún no tienes avisos sobre tus perros perdidos.»
end
W --> U : Avisos con datos de contacto, lugar, información y fotografías
U -> W : Seleccionar un aviso
alt «Responder»
  U -> W : Escribir una respuesta y seleccionar «Responder»
  break FA-34-C: respuesta vacía
    W --> U : «Escribe una respuesta para quien envió el aviso»
  end
  W -> A : Responder aviso (PATCH /reports/sightings/{id}/reply\n{reply, status: REPLIED})
  activate A
  A -> DB : Guardar respuesta y estado REPLIED (UPDATE report_sightings)
  activate DB
  DB --> A : Aviso actualizado
  deactivate DB
  A ->> DB : Notificar a quien envió el aviso (INSERT notifications)
  A --> W : 200 Aviso
  deactivate A
  W --> U : «Respuesta enviada»
else FA-34-A: «Abrir caso»
  U -> W : Seleccionar «Abrir caso»
  W -> A : Abrir caso (POST /cases/sighting/{sightingId})
  activate A
  A -> DB : Crear caso (INSERT cases: tipo LOST, estado OPEN)\ny su primer mensaje (INSERT case_messages)
  activate DB
  DB --> A : Caso creado
  deactivate DB
  A -> DB : Marcar el aviso (UPDATE report_sightings SET status = CASE_OPENED)
  activate DB
  DB --> A : Aviso actualizado
  deactivate DB
  A --> W : 200 Caso
  deactivate A
  W --> U : «Caso abierto»
  ref over U, DB : CU-28 Dar seguimiento a casos
else FA-34-B: «No es mi perro»
  U -> W : Seleccionar «No es mi perro»
  W -> A : Descartar aviso (PATCH /reports/sightings/{id}/case\n{status: DISMISSED})
  activate A
  A -> DB : Actualizar estado (UPDATE report_sightings)
  activate DB
  DB --> A : Aviso actualizado
  deactivate DB
  A --> W : 200
  deactivate A
  W --> U : «Aviso descartado»
end
deactivate W

note over U, DB : Postcondición: el aviso queda respondido, con un caso abierto o descartado.
@enduml
