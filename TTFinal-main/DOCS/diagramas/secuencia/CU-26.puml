@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-26 Cancelar solicitud de adopción
autonumber

actor "Usuario general" as U
participant "Interfaz web\n(Solicitudes)" as W
participant "API REST\n(AdoptionRequestController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el usuario ha iniciado sesión y la solicitud le pertenece y está pendiente.

ref over U, DB : CU-06 Consultar solicitudes realizadas
note over U, W : FA-26-A: si la solicitud ya fue atendida,\nla opción «Cancelar solicitud» no se muestra.
U -> W : Seleccionar «Cancelar solicitud» en una solicitud pendiente
activate W
alt operación exitosa
  W -> A : Cancelar solicitud (DELETE /adoption-requests/{id}?userId={userId})
  activate A
  A -> DB : Consultar la solicitud (adoption_requests)
  activate DB
  DB --> A : Solicitud
  deactivate DB
  A -> A : Verificar que sea de quien la creó (o un Administrador)\ny que siga en estado PENDING
  alt FA-26-B: no es quien la creó
    A --> W : 403 «Solo quien creó la solicitud puede cancelarla»
    W --> U : Mostrar el error
  else FA-26-B: ya no está pendiente
    A --> W : 400 «Solo puedes cancelar solicitudes pendientes»
    W --> U : Mostrar el error
  else solicitud propia y pendiente
    A -> DB : Eliminar la solicitud (DELETE adoption_requests)
    activate DB
    DB --> A : Eliminada
    deactivate DB
    A --> W : 200
    deactivate A
    W -> A : Recargar solicitudes (GET /adoption-requests/user/{userId})
    activate A
    A --> W : 200 Lista
    deactivate A
    W --> U : «Solicitud cancelada» y el listado actualizado
  end
else FA-26-C: error al cancelar
  W --> U : «No se pudo cancelar la solicitud»; conservarla
end
deactivate W

note over U, DB : Postcondición: la solicitud se elimina y deja de mostrarse al responsable de la publicación.
@enduml
