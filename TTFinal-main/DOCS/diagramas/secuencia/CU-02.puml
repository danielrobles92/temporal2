@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-02 Iniciar sesión
autonumber

actor "Usuario\n(general, Refugio o Administrador)" as U
participant "Interfaz web\n(Inicio de sesión)" as W
participant "API REST\n(LoginController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el actor cuenta con una cuenta registrada (CU-01 o CU-36).

U -> W : Acceder a la pantalla de inicio de sesión
activate W
opt FA-02-H: marcó «Recordarme» en su acceso anterior
  W --> U : Mostrar el correo precargado
end
W --> U : Solicitar correo y contraseña
opt FA-02-G: olvidó su contraseña
  ref over U, W : CU-43 Recuperar contraseña
end
U -> W : Capturar credenciales, marcar opcionalmente «Recordarme»\ny seleccionar «Iniciar Sesión»
W -> W : Validar formato (correo válido, contraseña ≥ 6 caracteres)
break FA-02-A: formato inválido
  W --> U : Señalar el campo con el error
end
alt operación exitosa
  W -> A : Autenticar (POST /auth/login {email, password, rememberMe})
  activate A
  A -> A : Verificar que el correo no esté bloqueado\npor intentos fallidos (LoginAttemptService)
  break FA-02-C: cinco intentos fallidos, bloqueo de 15 minutos
    A --> W : «Demasiados intentos fallidos. Intenta de nuevo en unos minutos.»
    W --> U : Mostrar el mensaje
  end
  A -> DB : Buscar usuario por correo (users)
  activate DB
  alt FA-02-B: correo no registrado
    DB --> A : Sin coincidencias
    A -> A : Registrar intento fallido
    A --> W : «Correo o contraseña incorrectos»
    W --> U : Mostrar el mensaje genérico
  else usuario encontrado
    DB --> A : Datos del usuario
    deactivate DB
    A -> A : Verificar que la cuenta esté activa
    break FA-02-D: cuenta desactivada por el Administrador
      A --> W : «Cuenta desactivada»
      W --> U : Mostrar el mensaje
    end
    A -> A : Verificar la contraseña (BCrypt)
    break FA-02-B: contraseña incorrecta
      A -> A : Registrar intento fallido
      A --> W : «Correo o contraseña incorrectos»
      W --> U : Mostrar el mensaje genérico
    end
    A -> A : Reiniciar el contador de intentos y generar el token JWT\n(rol, id, permiso para publicar; 4 h, o 7 días con «Recordarme»)
    A --> W : 200 {success, token, role, publishingAuthorized}
    deactivate A
    W -> W : Guardar la sesión en el navegador y,\nsi marcó «Recordarme», recordar el correo
    W --> U : Página de inicio con el menú del rol
  end
else FA-02-E: sin conexión con el servidor
  W --> U : Informar la falla e invitar a intentarlo de nuevo
end
deactivate W
note over U, DB : FA-02-F: al vencer el token, la interfaz cierra la sesión y pide iniciar sesión de nuevo.

note over U, DB : Postcondición: existe una sesión activa (token JWT) con los permisos del rol del actor.
@enduml
