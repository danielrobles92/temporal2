@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-08 Registrar reporte de perro encontrado
autonumber

actor "Usuario general / Refugio" as U
participant "Interfaz web\n(Publicar Anuncio)" as W
participant "OpenStreetMap\n(Nominatim)" as MAP
participant "API REST\n(ReportsController)" as A
participant "Servicio de IA\n(ml-service DogNet v2)" as IA
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el actor (Usuario general o Refugio) ha iniciado sesión.

U -> W : Seleccionar «Publicar Anuncio» y el tipo «Perro encontrado»
activate W
U -> W : Capturar la información observada: un nombre para identificarlo, raza,\nsexo, color, ubicación (alcaldía) y datos opcionales
break FA-08-G: selecciona «Cancelar»
  W --> U : Regresar a la pantalla anterior sin registrar
end
U -> W : Marcar en el mapa el punto donde lo encontró
opt FA-08-D: busca una dirección
  U -> W : Escribir la dirección y seleccionar «Buscar»
  W -> MAP : Buscar dirección (GET /search, Ciudad de México)
  activate MAP
  MAP --> W : Resultados
  deactivate MAP
  alt sin resultados
    W --> U : «No se encontró esa dirección en la Ciudad de México…»
  else hay resultados
    U -> W : Elegir un resultado
  end
end
W -> MAP : Obtener la dirección del punto (GET /reverse lat, lon)
activate MAP
MAP --> W : Calle, colonia y alcaldía
deactivate MAP
opt FA-08-E: no se obtiene la dirección
  W --> U : Conservar el punto y permitir escribir la referencia
end
W --> U : Completar referencia o colonia y alcaldía
U -> W : Adjuntar de 1 a 4 fotografías y elegir la principal
opt FA-08-B: una foto supera 3 MB
  W --> U : «Cada imagen no debe superar 3MB»
end
loop para cada fotografía
  ref over W, IA : CU-41 Analizar fotografía con la red neuronal
  alt FA-08-C: la foto no es de un perro
    W --> U : Indicar el motivo y bloquear la publicación
  else es un perro
    W --> U : Mostrar los atributos detectados
  end
end
U -> W : Seleccionar «Publicar Anuncio»
W -> W : Validar datos obligatorios y fotos
break FA-08-A: falta un dato obligatorio o no hay fotos
  W --> U : Señalar el campo
end
alt operación exitosa
  W -> A : Registrar reporte (POST /reports multipart, tipo FOUND)
  activate A
  A -> IA : Verificar que cada foto sea de un perro (POST /describe)
  activate IA
  IA --> A : Resultado
  deactivate IA
  break FA-08-C: alguna foto no es de perro
    A --> W : 422 con el motivo
    W --> U : Mostrar el motivo
  end
  A -> A : Guardar los archivos de las fotos
  A -> DB : Registrar reporte (INSERT lost_pets: estado OPEN,\nfoto principal y lista de fotos)
  activate DB
  DB --> A : reportId
  deactivate DB
  loop para cada fotografía
    A -> IA : Obtener vector y raza (POST /analyze)
    activate IA
    IA --> A : Vector de 1,280 valores y raza
    deactivate IA
    A -> DB : Guardar vector (INSERT report_image_embeddings)
    activate DB
    DB --> A : Guardado
    deactivate DB
  end
  A --> W : 200 Reporte registrado
  deactivate A
  W --> U : «Reporte publicado correctamente»
  ref over U, DB : CU-31 Consultar coincidencias sugeridas
else FA-08-F: error al almacenar
  W --> U : Informar la falla y conservar el formulario
end
deactivate W

note over U, DB : Postcondición: el reporte queda publicado en «Mascotas Perdidas»; quien crea que es su perro puede enviar un aviso (CU-30).
@enduml
