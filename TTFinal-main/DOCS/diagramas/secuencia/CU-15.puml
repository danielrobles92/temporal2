@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-15 Revisar solicitudes de adopción
autonumber

actor "Responsable de la publicación\n(Refugio o Usuario general autorizado)" as U
participant "Interfaz web\n(Solicitudes)" as W
participant "API REST\n(AdoptionRequestController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el actor ha iniciado sesión como Refugio o como Usuario general con autorización vigente, y existe al menos una solicitud sobre sus publicaciones (CU-05).

U -> W : Seleccionar «Solicitudes» en su menú o la notificación\nde nueva solicitud (CU-27)
activate W
W -> W : Verificar que puede revisar solicitudes\n(rol Refugio, Administrador o permiso para publicar)
alt operación exitosa
  W -> A : Consultar solicitudes recibidas\n(GET /adoption-requests/owner/{ownerId})
  activate A
  A -> DB : Consultar los perros del responsable (pets)
  activate DB
  DB --> A : Identificadores de sus perros
  deactivate DB
  A -> DB : Consultar las solicitudes de esos perros con sus respuestas\n(adoption_requests, applicant_answers)
  activate DB
  DB --> A : Solicitudes
  deactivate DB
  A --> W : 200 Lista
  deactivate A
  U -> W : Seleccionar el filtro «recibidas»
  break FA-15-A: no hay solicitudes para el filtro
    W --> U : «No hay solicitudes para este filtro»
  end
  W --> U : Cada solicitud con el perro, solicitante, fecha, mensaje, correo,\nteléfono, estado y resumen de sus respuestas\n(«N respuestas · Para platicar: …»)
  note right of W : FA-15-D: si el solicitante cancela su solicitud\npendiente (CU-26), deja de aparecer en el listado.
  U -> W : Seleccionar una solicitud
  W --> U : Detalle: estado, fecha y hora, solicitante, correo, teléfono,\nmensaje, respuestas a las preguntas (con el porqué de las\nde la raza) y notas de la decisión
  opt FA-15-C: la solicitud está pendiente
    alt «Contactar»
      ref over U, DB : CU-16 Aprobar solicitud y contactar al adoptante
    else «Cancelar»
      ref over U, DB : CU-17 Rechazar solicitud de adopción
    end
  end
else FA-15-B: error al consultar
  W --> U : Mostrar el mensaje de error
end
deactivate W

note over U, DB : Postcondición: el actor conoce las solicitudes recibidas y su estado.
@enduml
