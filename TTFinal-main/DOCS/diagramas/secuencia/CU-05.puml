@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-05 Realizar solicitud de adopción
autonumber

actor "Usuario general" as U
participant "Interfaz web\n(Adopción)" as W
participant "API REST\n(AdoptionRequestController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el usuario ha iniciado sesión y existe un perro disponible publicado por otro usuario.

ref over U, DB : CU-03 Consultar perros en adopción (detalle del perro)
break FA-05-A / FA-05-B: el perro no está disponible o la publicación es propia
  W --> U : La opción «Solicitar adopción» aparece deshabilitada
end
U -> W : Seleccionar «Solicitar adopción»
activate W
W --> U : Paso 1 «Datos a considerar»: aviso de que contestará\npreguntas de opción múltiple que verá el responsable
ref over U, W : CU-35 Consultar recomendaciones por raza (resumen de la raza)
break FA-05-H: no marca la casilla
  W --> U : «Continuar con la solicitud» permanece deshabilitado
end
U -> W : Marcar «Leí esta información y la tomé en cuenta»\ny seleccionar «Continuar con la solicitud»
W --> U : Paso 2: nombre, correo y teléfono precargados, preguntas de opción\nmúltiple (generales y de la raza) y campo de mensaje
U -> W : Contestar las preguntas, revisar los datos, escribir un mensaje\n(opcional) y seleccionar «Enviar solicitud»
break FA-05-F: selecciona «Cancelar»
  W --> U : Ocultar el formulario sin enviar
end
W -> W : Verificar nombre y correo obligatorios, teléfono de 10 dígitos,\nque todas las preguntas tengan respuesta y que el perro esté disponible
break FA-05-C / FA-05-G: falta un dato, un dato no es válido o falta contestar alguna pregunta
  W --> U : Señalar lo que falta (las preguntas sin contestar en naranja)\ny solicitar corregirlo
end
alt operación exitosa
  W -> A : Registrar solicitud (POST /adoption-requests\n{petId, contactName, contactEmail, contactPhone, message, answers})
  activate A
  A -> A : Tomar al solicitante del token JWT (RN-01)
  A -> DB : ¿Existe una solicitud del usuario para el perro? (adoption_requests)
  activate DB
  alt FA-05-D: ya existe una solicitud
    DB --> A : Solicitud existente
    A --> W : 400 «Ya enviaste una solicitud para este perro»
    W --> U : Mostrar el mensaje
  else no existe
    DB --> A : No existe
    deactivate DB
    A -> DB : Consultar el perro (pets)
    activate DB
    DB --> A : Responsable y estado del perro
    deactivate DB
    A -> A : Verificar que no sea su propia publicación\ny que el estado sea Disponible
    break FA-05-A: el perro dejó de estar disponible
      A --> W : 400 «Este perro ya no está disponible para adopción»
      W --> U : Mostrar el mensaje
    end
    A -> DB : Registrar la solicitud con sus respuestas (INSERT adoption_requests:\nestado PENDING, applicant_answers)
    activate DB
    DB --> A : Solicitud registrada
    deactivate DB
    A ->> DB : Notificar al responsable «Nueva solicitud de adopción para [perro]»\n(INSERT notifications)
    A --> W : 200 Solicitud
    deactivate A
    W --> U : «Solicitud enviada. [responsable] verá tus respuestas.»\ny cerrar el detalle
  end
else FA-05-E: error del servidor
  W --> U : Informar la falla y conservar los datos
end
deactivate W

note over U, DB : Postcondición: la solicitud queda pendiente con las respuestas del solicitante y el responsable de la publicación recibe una notificación (CU-15).
@enduml
