@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #D6E6FA
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #D6E6FA
  ParticipantFontColor #0D2B4E
  ActorBorderColor #1565C0
  ActorBackgroundColor #D6E6FA
  GroupBorderColor #1565C0
  GroupBackgroundColor #EEF5FD
  GroupHeaderFontStyle bold
  DividerBorderColor #1565C0
  ReferenceBorderColor #1565C0
  ReferenceBackgroundColor #EEF5FD
}
skinparam database {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
skinparam note {
  BorderColor #1565C0
  BackgroundColor #D6E6FA
}
mainframe sd CU-42 Cerrar caso
autonumber

actor "Responsable del caso" as U
participant "Interfaz web\n(Casos)" as W
participant "API REST\n(CasesController)" as A
database "Base de datos\n(PostgreSQL)" as DB

note over U, DB : Precondición: el usuario es el responsable del caso (responsable de la publicación en un caso de adopción o autor del reporte en un caso de perro perdido) y el caso existe (CU-28).

ref over U, DB : CU-28 Dar seguimiento a casos (el usuario abre el caso)
W -> W : Verificar que el usuario sea el responsable\ny mostrar las opciones según el tipo de caso
alt «Marcar adoptado» (caso de adopción)
  U -> W : Seleccionar «Marcar adoptado»
  activate W
  alt operación exitosa
    W -> A : Cambiar estado (PATCH /cases/{caseId}/status\n{status: ADOPTED, actorId, message: «Adopción completada.»})
    activate A
    A -> DB : Actualizar el caso y registrar el mensaje\n(UPDATE cases, INSERT case_messages)
    activate DB
    DB --> A : Caso actualizado
    deactivate DB
    A -> DB : Cambiar el perro a adoptado (UPDATE pets SET status = ADOPTED)
    activate DB
    DB --> A : Perro actualizado
    deactivate DB
    A ->> DB : Notificar al otro participante el nuevo estado (INSERT notifications)
    A --> W : 200 Caso
    deactivate A
    W --> U : «Caso actualizado» con el nuevo estado
  else FA-42-D: error al actualizar
    W --> U : «No se pudo actualizar el caso»; conservar el estado
  end
else FA-42-A: «Cancelar caso» (caso de adopción)
  U -> W : Seleccionar «Cancelar caso»
  W -> A : Cambiar estado (PATCH /cases/{caseId}/status {status: CANCELLED})
  activate A
  A -> DB : Actualizar el caso (UPDATE cases)
  activate DB
  DB --> A : Caso actualizado
  deactivate DB
  A ->> DB : Notificar al otro participante (INSERT notifications)
  A --> W : 200 Caso
  deactivate A
  W --> U : «Caso actualizado»; el estado del perro no cambia
else FA-42-B: «Caso resuelto» (perro perdido)
  U -> W : Seleccionar «Caso resuelto»
  W -> A : Cambiar estado (PATCH /cases/{caseId}/status {status: RESOLVED})
  activate A
  A -> DB : Actualizar el caso (UPDATE cases) y el reporte\n(UPDATE lost_pets SET status = RESOLVED)
  activate DB
  DB --> A : Registros actualizados
  deactivate DB
  A ->> DB : Notificar al otro participante (INSERT notifications)
  A --> W : 200 Caso
  deactivate A
  W --> U : «Caso actualizado»
else FA-42-C: «No es mi perro» (perro perdido)
  U -> W : Seleccionar «No es mi perro»
  W -> A : Cambiar estado (PATCH /cases/{caseId}/status {status: CANCELLED})
  activate A
  A -> DB : Actualizar el caso (UPDATE cases)
  activate DB
  DB --> A : Caso actualizado
  deactivate DB
  A ->> DB : Notificar al otro participante (INSERT notifications)
  A --> W : 200 Caso
  deactivate A
  W --> U : «Caso actualizado»; el reporte permanece abierto
end
deactivate W

note over U, DB : Postcondición: el caso queda adoptado, resuelto o cancelado; en una adopción concluida, el perro deja de mostrarse como disponible.
@enduml
